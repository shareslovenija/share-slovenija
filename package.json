{
  "name": "share-international-slovenija",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-content.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "import:master": "node scripts/import-master-articles.mjs",
    "import:books": "node scripts/import-books.mjs",
    "import:revija": "node scripts/import-magazine.mjs",
